# ---------------------------------------------------------------------------
# intern_finder_bot - environment
#
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
# On the Oracle VM these live in the systemd unit's EnvironmentFile instead
# (see apps/worker/deploy/intern-finder-worker.service).
# ---------------------------------------------------------------------------

# --- Supabase (Phase 1 - required) -----------------------------------------
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# service_role key. Bypasses RLS - worker only, NEVER ship this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# anon key. Used by the Next.js dashboard in Phase 3, not by the worker.
SUPABASE_ANON_KEY=

# --- Adzuna (Phase 1 - required for live pulls) -----------------------------
# Register: https://developer.adzuna.com/  ->  free tier
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Free tier is metered per day; the worker also enforces sources.max_calls_per_day.
ADZUNA_COUNTRY=au

# --- Jooble (Phase 1 - required for live pulls) -----------------------------
# Request a key: https://jooble.org/api/about
JOOBLE_API_KEY=

# --- Anthropic (Phase 2) ----------------------------------------------------
ANTHROPIC_API_KEY=
# Sonnet, not Opus - this loop runs continuously and cost matters.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Telegram (Phase 3) -----------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Worker behaviour -------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# Master loop tick. Per-source cadence is set in the `sources` table, not here.
WORKER_TICK_SECONDS=300

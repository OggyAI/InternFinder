# systemd unit for the polling worker on the Oracle Cloud Always Free VM
# (VM.Standard.E2.1.Micro). Same shape as the LibStaffer bot: a long-lived
# polling loop, restarted on failure, logging to journald.
#
# Install:
#   sudo cp intern-finder-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now intern-finder-worker
#
# Watch:      journalctl -u intern-finder-worker -f
# Restart:    sudo systemctl restart intern-finder-worker
#
# NOTE: /pause and /resume from Telegram (Phase 3) flip app_settings.is_paused
# in the database. They do NOT stop this service — the loop keeps ticking and
# simply does no work. Stopping the unit is a separate, heavier action.

[Unit]
Description=intern_finder_bot polling worker
Documentation=https://github.com/YOUR_USER/intern_finder_bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/intern-finder-bot

# All credentials live here, never in this unit file and never in the repo.
#   sudo install -o ubuntu -g ubuntu -m 600 /dev/null /etc/intern-finder-bot.env
#   sudo -u ubuntu editor /etc/intern-finder-bot.env
# Mode 0600 matters: this file holds the Supabase service_role key, which
# bypasses RLS on every table.
EnvironmentFile=/etc/intern-finder-bot.env
Environment=NODE_ENV=production

ExecStart=/usr/bin/npm run start --workspace @intern-finder/worker

# The loop already swallows per-cycle errors, so a process exit means something
# genuinely unrecoverable (bad env, OOM). Back off rather than hot-looping.
Restart=on-failure
RestartSec=30s
StartLimitIntervalSec=300
StartLimitBurst=5

# Graceful stop: SIGTERM makes the loop finish its current cycle and exit, so a
# restart never lands mid-upsert.
KillSignal=SIGTERM
TimeoutStopSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=intern-finder

# --- Hardening -------------------------------------------------------------
# The worker reads a config file and makes outbound HTTPS calls. It has no
# business writing anywhere on disk or seeing other users' processes.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/intern-finder-bot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false

# 1 GB of RAM on an E2.1.Micro, shared with anything else on the box.
MemoryMax=384M

[Install]
WantedBy=multi-user.target

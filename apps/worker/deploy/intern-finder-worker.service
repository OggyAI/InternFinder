# systemd unit for the polling worker.
#
# Target: the same Oracle Cloud Always Free VM that runs libstaffer-bot —
# Ubuntu 22.04, VM.Standard.E2.1.Micro (AMD x86_64), 1 OCPU, 1GB RAM.
# Deliberately mirrors libstaffer-bot.service: same user, same /home/ubuntu
# layout, same journalctl story, so there is one deployment model on the box
# rather than two.
#
# Install:
#   sudo cp intern-finder-worker.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now intern-finder-worker
#
# Logs:     journalctl -u intern-finder-worker -f
# Restart:  sudo systemctl restart intern-finder-worker
#
# NOTE: /pause and /resume from Telegram (Phase 3) flip app_settings.is_paused
# in the database. They do NOT stop this service — the loop keeps ticking and
# simply does no work. Stopping the unit is a separate, heavier action.

[Unit]
Description=intern_finder_bot polling worker
After=network-online.target
Wants=network-online.target

# These belong in [Unit], NOT [Service]. systemd moved them here in v229, and
# in [Service] it parses them, warns "Unknown key name", and silently ignores
# them — so the restart rate limit was doing nothing at all and a crash loop
# would have restarted every 30s indefinitely. Caught by reading the journal
# on first start.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/intern-finder-bot

# Credentials live in the repo-root .env at mode 0600, read by dotenv in
# packages/core/src/env.ts. This matches how libstaffer-bot does it rather
# than introducing a second convention with EnvironmentFile=. The file is
# gitignored, so it never reaches GitHub.
Environment=NODE_ENV=production

# tsx directly, not `npm run`. npm would fork an extra shell and an extra node
# process for no benefit, and on a 1GB box shared with another bot that is
# ~40MB of pure overhead.
ExecStart=/home/ubuntu/intern-finder-bot/node_modules/.bin/tsx apps/worker/src/index.ts

# The loop already swallows per-cycle errors, so a process exit means something
# genuinely unrecoverable (bad env, OOM). Back off rather than hot-looping.
Restart=on-failure
RestartSec=30s

# Graceful stop: SIGTERM makes the loop finish its current cycle and exit, so a
# restart never lands mid-upsert.
KillSignal=SIGTERM
TimeoutStopSec=120

StandardOutput=journal
StandardError=journal
SyslogIdentifier=intern-finder

# --- Hardening -------------------------------------------------------------
# The worker reads a config file and makes outbound HTTPS calls. It has no
# business writing anywhere else on disk.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/intern-finder-bot
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true

# ProtectHome is deliberately NOT set. It defaults to off, and turning it on
# would make /home/ubuntu — where this app actually lives — invisible to the
# service, so it would fail at startup with a misleading "not found".
# An earlier version of this file had ProtectHome=true from when the app was
# assumed to live in /opt. Do not reinstate it without moving the app.

# Set from measurement, not guesswork. A full Adzuna cycle on this VM — 51
# keyword queries, 1636 listings fetched, 988 written — peaked at 121.5 MB
# resident and took 96 seconds.
#
# MemoryHigh throttles and reclaims first; MemoryMax is the hard ceiling that
# triggers an OOM kill. The gap means a spike gets slowed rather than killed.
# ~1.6x peak to throttle and ~2.5x to kill leaves room for the listing volume
# to grow while still catching a genuine runaway before it threatens
# libstaffer-bot (which uses 29 MB) or the box (956 MB total, 2 GB swap).
MemoryHigh=200M
MemoryMax=300M

[Install]
WantedBy=multi-user.target
